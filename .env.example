# Copy this file to .env and replace every CHANGE_ME value.
PORT=3001
NODE_ENV=production
# Exact deployed frontend origin, with no trailing slash. Add localhost during local testing if needed.
FRONTEND_ORIGINS=https://YOUR-CLOCKIT-SITE.vercel.app
# Generate a long random secret. Keep it private and never commit .env.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
# These are the only two allowed chat accounts. Use unique usernames and long, unique passwords.
USER1_USERNAME=yourusername
USER1_PASSWORD=CHANGE_ME_USER1_LONG_PASSWORD
USER2_USERNAME=herusername
USER2_PASSWORD=CHANGE_ME_USER2_LONG_PASSWORD
# Nightly deletion schedule uses this local timezone.
SWEEP_TIMEZONE=America/Chicago
